# Copie este arquivo para .env e preencha os valores.
# NUNCA coloque valores reais neste arquivo (.env.example) nem no código —
# o .env real não deve ser commitado (já está no .gitignore).

# Chave secreta do Flask (sessões/cookies). Gere uma forte, ex.:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Login com Google (Google Cloud Console > APIs & Services > Credentials
# > OAuth client ID > Web application). Ver instruções completas no
# README (seção "Login com Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve ser IDÊNTICA a uma das "Authorized redirect URIs" cadastradas no
# Google Cloud Console. Em produção, troque para o domínio real (https).
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Horário (fuso America/Sao_Paulo) da automação diária de vestibulares.
VESTIBULARES_CRON_HORA=3
VESTIBULARES_CRON_MINUTO=0

# 1 = modo debug/reloader do Flask (padrão). Em produção, use 0.
FLASK_DEBUG=1
# Porta do servidor (opcional, padrão 5000).
PORT=5000
