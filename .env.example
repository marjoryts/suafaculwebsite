# ─────────────────────────────────────────────────────────────────────────────
# SuaFacul — variáveis de ambiente (copie para .env e preencha; o .env NÃO vai
# para o Git). Na Vercel, cadastre em Project Settings → Environment Variables.
# Guia completo: docs/migracao-supabase.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados: Supabase (PostgreSQL) ────────────────────────────────────
# Conexão da APLICAÇÃO: papel restrito suafacul_backend, pelo pooler do
# Supabase em modo transaction (porta 6543). Painel → Connect → Transaction pooler;
# troque o usuário "postgres.<ref>" por "suafacul_backend.<ref>".
DATABASE_URL=postgresql://suafacul_backend.<project-ref>:<senha-do-suafacul_backend>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require
# Conexões no pool por processo (serverless: mantenha baixo).
DB_POOL_MAX=5

# Conexão ADMINISTRATIVA (papel postgres), usada SÓ na sua máquina/CI para
# `flask --app wsgi init-db` (migrations) e `flask --app wsgi migrar-sqlite`.
# NUNCA cadastre esta variável na Vercel nem em nenhum frontend.
# Painel → Connect → Session pooler (porta 5432) ou Direct connection.
# DATABASE_URL_ADMIN=postgresql://postgres.<project-ref>:<senha-do-banco>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Flask ────────────────────────────────────────────────────────────────────
# Obrigatória fora do debug: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# 1 só em desenvolvimento local (recarga automática; chave efêmera se faltar a de cima)
FLASK_DEBUG=0
# 0 apenas se rodar sem HTTPS e sem debug
# SESSION_COOKIE_SECURE=0

# ── Primeiro administrador (criado uma única vez pelo init-db, se não houver admin) ──
SUAFACUL_ADMIN_USER=admin
SUAFACUL_ADMIN_EMAIL=
SUAFACUL_ADMIN_PASSWORD=

# ── Login com Google (opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client IDs dos apps Mobile aceitos no ID token (login Google no app), se usar
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=

# ── Vercel Cron (mínimo 16 caracteres; sem ela os endpoints de cron ficam desligados) ──
CRON_SECRET=

# ── Testes (pytest): PostgreSQL onde o usuário pode criar bancos ─────────────
# TEST_DATABASE_URL=postgresql://postgres:senha@localhost:5432/postgres
# Opcional — roda a aplicação com o papel restrito (sujeito a RLS):
# TEST_DATABASE_APP_USER=suafacul_backend
# TEST_DATABASE_APP_PASSWORD=
