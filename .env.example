# Copie este arquivo para ".env" e preencha com suas credenciais.
# Sem essas variáveis, o site funciona normalmente — só o login com
# Google fica desabilitado (erro amigável, não quebra o site).

# Console do Google Cloud > APIs & Services > Credentials > OAuth client ID
# > Web application. Cadastre GOOGLE_CALLBACK_URL em "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Opcional: chave usada para assinar a sessão/cookies. Gere uma própria em
# produção (ex: python -c "import secrets; print(secrets.token_hex(32))").
FLASK_SECRET_KEY=
